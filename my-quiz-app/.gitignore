# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ----------------------------------------------------------------------
# LOCAL IGNORES (Rules relative to the my-quiz-app/ directory)
# ----------------------------------------------------------------------

# Standard system files
.DS_Store

# Dependencies
/node_modules
/.pnp
.pnp.js

# Build/Production/Testing
/coverage
/build
/dist

# Local Environment Variables (Crucial to keep secrets out of Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----------------------------------------------------------------------
# AMPLIFY-CLI IGNORES (Crucial files for security and build stability)
# ----------------------------------------------------------------------

# Environment/Deployment-Specific Config
amplify/\#current-cloud-backend
amplify/.config/local-*
amplify/backend/amplify-meta.json
amplify/backend/.temp
amplify/backend/awscloudformation/

# Generated Artifacts
amplify/logs
amplify/mock-data
amplify/mock-api-resources
amplify/hooks/post-push.sh.sample
amplify/hooks/pre-push.js.sample

# Frontend Integration Files (Generated by Amplify)
aws-exports.js
awsconfiguration.json
amplifyconfiguration.json
amplifyconfiguration.dart
src/amplifyconfiguration.json
src/aws-exports.js

# Other generated/temporary files
amplify-build-config.json
amplify-gradle-config.json
amplifytools.xcconfig
.secret-*
**.sample
